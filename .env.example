# MaxMind License Key (Required for auto-updates)
MAXMIND_LICENSE_KEY=your_license_key_here

# Cron Schedule (Optional, default is Saturday at 3 AM)
# Format: Minute Hour DayOfMonth Month DayOfWeek
CRON_SCHEDULE=0 3 * * 6

# Run an extraction when the container starts (Optional, default is true)
# Set to false to wait for the first scheduled run
RUN_ON_START=true
